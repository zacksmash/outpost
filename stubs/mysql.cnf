# Outpost sandbox overrides. The zz- prefix keeps this file sorting last
# so its values win over the distribution defaults. The application lives
# in the same container. Supervisor selects loopback or the instance network
# explicitly for each manifest; this default enables opt-in host access.

[mysqld]
bind-address = 0.0.0.0
skip-name-resolve
innodb_buffer_pool_size = 256M
max_connections = 100
